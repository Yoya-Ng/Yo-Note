---
import BaseLayout from "@components/base/BaseLayout.astro";
import { markdownify } from "@lib/textConverter";
import LoginForm from "@components/login/LoginForm.vue";

const title = "登入";
const description = "站長管理登入";
---

<!-- 只給站長使用：不讓搜尋引擎收錄，也不進站內搜尋索引 -->
<BaseLayout title={title} description={description} noindex={true}>
  <section class="section" data-pagefind-ignore="all">
    <div class="container">
      <div class="row justify-center">
        <div class="text-center md:text-left lg:col-6">
          <h1 set:html={markdownify(title)} class="mb-4" />
          <p class="mb-8">{description}</p>
          <LoginForm client:load />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
